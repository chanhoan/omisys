# 로컬 IDE 실행용 환경변수 예시.
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env* 는 .gitignore 대상이다.
# IntelliJ 는 EnvFile 플러그인으로, 셸은 `set -a; . ./.env.local; set +a` 로 읽는다.
#
# 절차 전체는 docs/development/local-setup.md 참조.

# ---------------------------------------------------------------------------
# 0. 원격 의존성 서버 접속 정보 — scripts/tunnel.sh 가 이 파일에서 읽는다.
#    SSH 키는 저장소 루트의 omisys.pem 으로 고정이라 여기에 적을 값이 없다.
# ---------------------------------------------------------------------------
OMISYS_DEP_HOST=ubuntu@<elastic-ip>

# ---------------------------------------------------------------------------
# 1. 로컬 인프라 주소 — 애플리케이션이 Docker 가 아니라 로컬에서 뜨기 때문에 필요하다.
#    미설정 시 기본값이 Docker 호스트명(config-server / eureka-service)이라 로컬에서는 해석되지 않는다.
# ---------------------------------------------------------------------------
CONFIG_SERVER_URI=http://localhost:8888
EUREKA_URI=http://localhost:19090/eureka/

# ---------------------------------------------------------------------------
# 2. Config Server 가 설정 저장소(private)를 클론할 자격증명.
#    repo 읽기 권한이면 충분하다. `gh auth token` 으로도 얻을 수 있다.
# ---------------------------------------------------------------------------
GIT_NAME=<github-username>
GIT_TOKEN=<github-personal-access-token>

# ---------------------------------------------------------------------------
# 3. SSH 터널이 MySQL 을 붙일 로컬 포트.
#    로컬에 MySQL 이 이미 3306 을 점유했을 때만 바꾼다. 비워 두면 3306 이다.
#    터널과 애플리케이션이 같은 값을 써야 한다.
# ---------------------------------------------------------------------------
# LOCAL_MYSQL_PORT=13306

# ---------------------------------------------------------------------------
# 4. 원격 MySQL 스키마 계정 비밀번호.
#    EC2 의 /opt/omisys/.env 에 생성돼 있다. 띄울 서비스 것만 채우면 된다.
#      ssh -i <key.pem> ubuntu@<host> "cat /opt/omisys/.env"
#    DATABASE / USER 는 omisys_<svc> 가 기본값이라 보통 생략한다.
# ---------------------------------------------------------------------------
USER_MYSQL_PASSWORD=
PRODUCT_MYSQL_PASSWORD=
ORDER_MYSQL_PASSWORD=
PAYMENT_MYSQL_PASSWORD=
PROMOTION_MYSQL_PASSWORD=
REVIEW_MYSQL_PASSWORD=
NOTIFICATION_MYSQL_PASSWORD=
DELIVERY_MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# 5. Elasticsearch — product · search 를 띄울 때만 필요하다.
#    의존성 스택을 --profile search 로 올린 경우에 해당한다.
#
#    FINGERPRINT 는 비워 둔다. 값이 있으면 클라이언트가 HTTPS 로 붙는데,
#    의존성 스택의 ES 는 터널 뒤 평문 HTTP 로 뜬다.
# ---------------------------------------------------------------------------
ELASTIC_PASSWORD=
# ELASTIC_FINGERPRINT=

# ---------------------------------------------------------------------------
# 6. auth 서비스 — JWT 서명 키.
#    HS256 원시 UTF-8 바이트로 쓰이므로 32바이트 이상이어야 한다.
#    로컬 전용이라 직접 생성해도 된다:  openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# 7. auth 서비스 — Google OAuth.
#    빈 값이면 "Client id of registration 'google' must not be empty" 로 기동에 실패한다.
#    소셜 로그인을 실제로 쓰지 않으면 아무 값이나 넣어도 된다.
#
#    실제 발급: Google Cloud Console -> API 및 서비스 -> 사용자 인증 정보
#              -> OAuth 클라이언트 ID -> 웹 애플리케이션
#    승인된 리디렉션 URI: http://localhost:18082/login/oauth2/code/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 8. notification 서비스 — Gmail SMTP.
#    USERNAME 은 발신 Gmail 주소 전체, PASSWORD 는 계정 비밀번호가 아니라
#    앱 비밀번호 16자리다 (2단계 인증 후 myaccount.google.com/apppasswords).
#    메일을 실제로 보내지 않을 거면 더미값으로도 기동된다. 비어 있으면 기동에 실패한다.
#    발송 실패는 Notification.failed 로 기록될 뿐 앱을 멈추지 않는다.
# ---------------------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# 9. notification 서비스 — Firebase 서비스 계정 키 (FCM 푸시).
#    비워 두면 "FCM disabled" 경고만 남기고 정상 기동한다. 이메일은 영향 없다.
#    상대경로는 실행 방식마다 작업 디렉터리가 달라 절대경로로 적는다.
# ---------------------------------------------------------------------------
# FIREBASE_CREDENTIALS_PATH=C:/playground/omisys/firebase-adminsdk.json

# ---------------------------------------------------------------------------
# 10. payment 서비스 — 토스페이먼츠 시크릿 키.
#     결제를 실제로 호출하지 않으면 더미값으로도 기동된다.
# ---------------------------------------------------------------------------
TOSS_SECRET_KEY=
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 11. product 서비스 — 상품 이미지 업로드용 S3.
#     업로드를 실제로 쓰지 않으면 더미값으로도 기동된다.
# ---------------------------------------------------------------------------
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=ap-northeast-2

# ---------------------------------------------------------------------------
# 12. gateway 서비스 — 대기열이 허용하는 동시 접속 상한.
#    UserQueueService 가 기본값 없이 읽으므로 없으면 기동에 실패한다.
#    부하테스트에서 대기열 동작을 볼 때 조정한다.
# ---------------------------------------------------------------------------
MAX_ACTIVE_USERS=100

# ---------------------------------------------------------------------------
# 13. 서비스 간 내부 호출 시크릿.
#    application-local.yml 에 개발용 기본값이 있어 보통 설정하지 않는다.
# ---------------------------------------------------------------------------
# INTERNAL_SECRET=
