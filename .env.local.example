# 로컬 IDE 실행용 환경변수 예시.
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env* 는 .gitignore 대상이다.
# IntelliJ 는 EnvFile 플러그인으로, 셸은 `set -a; . ./.env.local; set +a` 로 읽는다.
#
# 절차 전체는 docs/development/local-setup.md 참조.

# ---------------------------------------------------------------------------
# 1. 로컬 인프라 주소 — 애플리케이션이 Docker 가 아니라 로컬에서 뜨기 때문에 필요하다.
#    미설정 시 기본값이 Docker 호스트명(config-server / eureka-service)이라 로컬에서는 해석되지 않는다.
# ---------------------------------------------------------------------------
CONFIG_SERVER_URI=http://localhost:8888
EUREKA_URI=http://localhost:19090/eureka/

# ---------------------------------------------------------------------------
# 2. Config Server 가 설정 저장소(private)를 클론할 자격증명.
#    repo 읽기 권한이면 충분하다. `gh auth token` 으로도 얻을 수 있다.
# ---------------------------------------------------------------------------
GIT_NAME=<github-username>
GIT_TOKEN=<github-personal-access-token>

# ---------------------------------------------------------------------------
# 3. SSH 터널이 MySQL 을 붙일 로컬 포트.
#    로컬에 MySQL 이 이미 3306 을 점유했을 때만 바꾼다. 비워 두면 3306 이다.
#    터널과 애플리케이션이 같은 값을 써야 한다.
# ---------------------------------------------------------------------------
# LOCAL_MYSQL_PORT=13306

# ---------------------------------------------------------------------------
# 4. 원격 MySQL 스키마 계정 비밀번호.
#    EC2 의 /opt/omisys/.env 에 생성돼 있다. 띄울 서비스 것만 채우면 된다.
#      ssh -i <key.pem> ubuntu@<host> "cat /opt/omisys/.env"
#    DATABASE / USER 는 omisys_<svc> 가 기본값이라 보통 생략한다.
# ---------------------------------------------------------------------------
USER_MYSQL_PASSWORD=
PRODUCT_MYSQL_PASSWORD=
ORDER_MYSQL_PASSWORD=
PAYMENT_MYSQL_PASSWORD=
PROMOTION_MYSQL_PASSWORD=
REVIEW_MYSQL_PASSWORD=
NOTIFICATION_MYSQL_PASSWORD=
DELIVERY_MYSQL_PASSWORD=

# ---------------------------------------------------------------------------
# 5. Elasticsearch — product · search 를 띄울 때만 필요하다.
#    의존성 스택을 --profile search 로 올린 경우에 해당한다.
# ---------------------------------------------------------------------------
ELASTIC_PASSWORD=
# ELASTIC_FINGERPRINT=

# ---------------------------------------------------------------------------
# 6. 서비스 간 내부 호출 시크릿.
#    application-local.yml 에 개발용 기본값이 있어 보통 설정하지 않는다.
# ---------------------------------------------------------------------------
# INTERNAL_SECRET=
