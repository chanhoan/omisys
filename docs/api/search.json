    "securitySchemes": {
      "accessToken": {
        "description": "로그인(POST /api/auth/sign-in)이 내려주는 JWT.\n\n게이트웨이가 쿠키의 accessToken 을 검증한 뒤 X-User-Claims 헤더로 바꿔\n각 서비스에 넘긴다. 브라우저는 쿠키만 실어 보내면 되고 헤더를 직접\n만들 필요가 없다. 서비스 간 호출은 Authorization: Bearer 도 받는다.",
        "in": "cookie",
        "name": "accessToken",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "omisys search service",
    "version": "v0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/search": {
      "get": {
        "operationId": "searchProducts",
        "parameters": [
          {
            "in": "query",
            "name": "keyword",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "categoryId",
            "required": false,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "brandName",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mainColor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "minPrice",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sortOption",
            "required": false,
            "schema": {
              "default": "RELEVANCE",
              "enum": [
                "RELEVANCE",
                "PRICE_LOW_TO_HIGH",
                "PRICE_HIGH_TO_LOW",
                "NEWEST",
                "OLDEST",
                "NAME_A_TO_Z",
                "NAME_Z_TO_A",
                "REVIEW",
                "BEST_SELLING"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 0,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 10,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResponseProductSearchDto"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "search-controller"
        ]
      }
    }
  },
  "security": [
    {
      "accessToken": []
    }
  ]
