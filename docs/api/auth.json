{
  "components": {
    "schemas": {
      "ApiResponseVoid": {
        "properties": {
          "data": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "statusName": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "JwtClaim": {
        "properties": {
          "role": {
            "type": "string"
          },
          "userId": {
            "format": "int64",
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SignIn": {
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "password",
          "username"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "omisys auth service",
    "version": "v0"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "parameters": [
          {
            "in": "cookie",
            "name": "refreshToken",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "auth-controller"
        ]
      }
    },
    "/api/auth/sign-in": {
      "post": {
        "operationId": "signIn",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "auth-controller"
        ]
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "signOut",
        "parameters": [
          {
            "in": "header",
            "name": "X-User-Claims",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "refreshToken",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "auth-controller"
        ]
      }
    },
    "/internal/auth/verify": {
      "get": {
        "operationId": "verifyToken",
        "parameters": [
          {
            "in": "header",
            "name": "Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JwtClaim"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "auth-internal-controller"
        ]
      }
    }
  }
}
